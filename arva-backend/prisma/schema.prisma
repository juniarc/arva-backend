generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int        @id @default(autoincrement())
  // Stored exactly as the user typed it, so the UI can show it back.
  username      String
  // Lowercase copy of username. The unique index lives here, which makes
  // "Alice" and "alice" collide. Always set by the service, never by clients.
  usernameLower String     @unique @map("username_lower")
  // Stored trimmed and lowercase.
  email         String     @unique
  passwordHash  String     @map("password_hash")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  shops         Shop[]
  cartItems     CartItem[]
  reviews       Review[]

  @@map("users")
}

enum BannerType {
  CAROUSEL
  PROMO_STRIP
  SIDE_BANNER
  VERTICAL_BANNER
}

model Category {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  name      String
  // The frontend uses this key to pick an icon.
  iconKey   String    @map("icon_key")
  sortOrder Int       @map("sort_order")
  products  Product[]

  @@map("categories")
}

model Shop {
  id           Int       @id @default(autoincrement())
  slug         String    @unique
  name         String
  city         String
  // Path or URL of the shop logo.
  logoUrl      String?   @map("logo_url")
  // Shop rating in tenths (34 = 3.4), same as products.
  ratingTenths Int       @default(0) @map("rating_tenths")
  ratingCount  Int       @default(0) @map("rating_count")
  // Null for seeded shops. Real shops get an owner when "create shop" is built.
  ownerId      Int?      @map("owner_id")
  owner        User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  products     Product[]

  @@map("shops")
}

model Product {
  id           Int              @id @default(autoincrement())
  slug         String           @unique
  name         String
  description  String           @default("")
  categoryId   Int              @map("category_id")
  category     Category         @relation(fields: [categoryId], references: [id])
  shopId       Int              @map("shop_id")
  shop         Shop             @relation(fields: [shopId], references: [id])
  imageUrl     String           @map("image_url")
  // Rating in tenths: 34 means 3.4. An Int avoids Decimal objects and float rounding.
  ratingTenths Int              @default(0) @map("rating_tenths")
  // Total ratings and written reviews. Stored (not counted) because review writing is not built yet.
  ratingCount  Int              @default(0) @map("rating_count")
  reviewCount  Int              @default(0) @map("review_count")
  soldCount    Int              @default(0) @map("sold_count")
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  variants     ProductVariant[]
  images       ProductImage[]
  reviews      Review[]

  @@index([categoryId])
  @@index([shopId])
  @@map("products")
}

model ProductVariant {
  id            Int        @id @default(autoincrement())
  productId     Int        @map("product_id")
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  label         String
  unit          String
  // Integer IDR.
  price         Int
  // Set only when the variant is discounted.
  originalPrice Int?       @map("original_price")
  // A CHECK constraint (stock >= 0) is added in the migration SQL.
  stock         Int
  // Order on screen. The variant with the lowest position is the default selection.
  position      Int        @default(0)
  cartItems     CartItem[]

  @@unique([productId, label])
  @@index([productId])
  @@map("product_variants")
}

model Banner {
  id          Int        @id @default(autoincrement())
  type        BannerType
  title       String
  subtitle    String?
  buttonLabel String?    @map("button_label")
  linkUrl     String?    @map("link_url")
  imageUrl    String     @map("image_url")
  // Order within its type.
  position    Int
  isActive    Boolean    @default(true) @map("is_active")

  @@unique([type, position])
  @@map("banners")
}

model CartItem {
  id        Int            @id @default(autoincrement())
  userId    Int            @map("user_id")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId Int            @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  // A CHECK constraint (quantity >= 1) is added in the migration SQL. The maximum of 99 is a service rule.
  quantity  Int
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@unique([userId, variantId])
  @@index([userId])
  @@map("cart_items")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  position  Int

  @@unique([productId, position])
  @@map("product_images")
}

model Review {
  id              Int      @id @default(autoincrement())
  productId       Int      @map("product_id")
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Null for seeded reviews. Never returned by the API.
  userId          Int?     @map("user_id")
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Copied from the username when the review was written, so the review keeps its name
  // if the user later changes their username or deletes their account.
  authorName      String   @map("author_name")
  authorAvatarUrl String?  @map("author_avatar_url")
  // A CHECK constraint (1 to 5) is added in the migration SQL.
  rating          Int
  text            String
  createdAt       DateTime @default(now()) @map("created_at")
  isVisible       Boolean  @default(true) @map("is_visible")

  @@index([productId, createdAt])
  @@map("reviews")
}
