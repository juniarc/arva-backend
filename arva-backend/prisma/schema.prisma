generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  // Stored exactly as the user typed it, so the UI can show it back.
  username      String
  // Display name. Register sets it to the username. The profile update changes it.
  name          String
  // Lowercase copy of username. The unique index lives here, which makes
  // "Alice" and "alice" collide. Always set by the service, never by clients.
  usernameLower String         @unique @map("username_lower")
  // Stored trimmed and lowercase.
  email         String         @unique
  passwordHash  String         @map("password_hash")
  // 8 to 15 digits with an optional leading "+" (CHECK constraint in the migration).
  phone         String?
  // Not written yet. Photo upload comes later.
  photoUrl      String?        @map("photo_url")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  shop          Shop?
  cartItems     CartItem[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  checkoutDraft CheckoutDraft?
  address       UserAddress?

  @@map("users")
}

enum BannerType {
  CAROUSEL
  PROMO_STRIP
  SIDE_BANNER
  VERTICAL_BANNER
}

model Category {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  name      String
  // The frontend uses this key to pick an icon.
  iconKey   String    @map("icon_key")
  sortOrder Int       @map("sort_order")
  products  Product[]

  @@map("categories")
}

model Shop {
  id               Int                   @id @default(autoincrement())
  // A URL identifier. It never changes, even when the shop is renamed.
  slug             String                @unique
  // Unique ignoring letter case. The functional index on lower(name) is in the migration SQL.
  name             String
  // The name of the shop's city. Kept for the product list city filter, and set from cityId
  // whenever the owner saves the address.
  city             String
  // Path or URL of the shop logo. Not written yet (logo upload comes later).
  logoUrl          String?               @map("logo_url")
  description      String                @default("")
  email            String?
  phone            String?
  street           String?
  zipCode          String?               @map("zip_code")
  provinceId       String?               @map("province_id")
  province         Province?             @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  cityId           String?               @map("city_id")
  cityRegion       City?                 @relation(fields: [cityId], references: [id], onDelete: SetNull)
  districtId       String?               @map("district_id")
  district         District?             @relation(fields: [districtId], references: [id], onDelete: SetNull)
  subDistrictId    String?               @map("sub_district_id")
  subDistrict      SubDistrict?          @relation(fields: [subDistrictId], references: [id], onDelete: SetNull)
  // "HH:MM", 24 hour.
  openingTime      String?               @map("opening_time")
  closingTime      String?               @map("closing_time")
  // Shop rating in tenths (34 = 3.4), same as products.
  ratingTenths     Int                   @default(0) @map("rating_tenths")
  ratingCount      Int                   @default(0) @map("rating_count")
  // Null for seeded shops. The unique ownerId means one shop per user (provisional).
  // Postgres allows many null values, so shops without an owner are fine.
  ownerId          Int?                  @unique @map("owner_id")
  owner            User?                 @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  products         Product[]
  shippingChannels ShopShippingChannel[]
  vouchers         Voucher[]

  @@index([city], map: "shops_city_idx")
  @@map("shops")
}

model Product {
  id            Int              @id @default(autoincrement())
  slug          String           @unique
  name          String
  description   String           @default("")
  categoryId    Int              @map("category_id")
  category      Category         @relation(fields: [categoryId], references: [id])
  shopId        Int              @map("shop_id")
  shop          Shop             @relation(fields: [shopId], references: [id])
  imageUrl      String           @map("image_url")
  // Rating in tenths: 34 means 3.4. An Int avoids Decimal objects and float rounding.
  ratingTenths  Int              @default(0) @map("rating_tenths")
  // Total ratings and written reviews. Stored (not counted) because review writing is not built yet.
  ratingCount   Int              @default(0) @map("rating_count")
  reviewCount   Int              @default(0) @map("review_count")
  soldCount     Int              @default(0) @map("sold_count")
  isActive      Boolean          @default(true) @map("is_active")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  variants      ProductVariant[]
  images        ProductImage[]
  reviews       Review[]
  wishlistItems WishlistItem[]

  @@index([categoryId])
  @@index([shopId])
  // Support the list sorts and the rating filter. id is the tie-breaker.
  @@index([isActive, soldCount(sort: Desc), id], map: "products_is_active_sold_count_id_idx")
  @@index([isActive, createdAt(sort: Desc), id(sort: Desc)], map: "products_is_active_created_at_id_idx")
  @@index([isActive, ratingTenths], map: "products_is_active_rating_tenths_idx")
  @@map("products")
}

model ProductVariant {
  id            Int        @id @default(autoincrement())
  productId     Int        @map("product_id")
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  label         String
  unit          String
  // Integer IDR.
  price         Int
  // Set only when the variant is discounted.
  originalPrice Int?       @map("original_price")
  // A CHECK constraint (stock >= 0) is added in the migration SQL.
  stock         Int
  // Order on screen. The variant with the lowest position is the default selection.
  position      Int        @default(0)
  cartItems     CartItem[]

  @@unique([productId, label])
  @@index([productId])
  // Lowest-price lookups for the price filters.
  @@index([productId, price], map: "product_variants_product_id_price_idx")
  @@map("product_variants")
}

model Banner {
  id          Int        @id @default(autoincrement())
  type        BannerType
  title       String
  subtitle    String?
  buttonLabel String?    @map("button_label")
  linkUrl     String?    @map("link_url")
  imageUrl    String     @map("image_url")
  // Order within its type.
  position    Int
  isActive    Boolean    @default(true) @map("is_active")

  @@unique([type, position])
  @@map("banners")
}

model CartItem {
  id        Int            @id @default(autoincrement())
  userId    Int            @map("user_id")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId Int            @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  // A CHECK constraint (quantity >= 1) is added in the migration SQL. The maximum of 99 is a service rule.
  quantity  Int
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  draftItems CheckoutDraftItem[]

  @@unique([userId, variantId])
  @@index([userId])
  @@map("cart_items")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  position  Int

  @@unique([productId, position])
  @@map("product_images")
}

model Review {
  id              Int      @id @default(autoincrement())
  productId       Int      @map("product_id")
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Null for seeded reviews. Never returned by the API.
  userId          Int?     @map("user_id")
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Copied from the username when the review was written, so the review keeps its name
  // if the user later changes their username or deletes their account.
  authorName      String   @map("author_name")
  authorAvatarUrl String?  @map("author_avatar_url")
  // A CHECK constraint (1 to 5) is added in the migration SQL.
  rating          Int
  text            String
  createdAt       DateTime @default(now()) @map("created_at")
  isVisible       Boolean  @default(true) @map("is_visible")

  @@index([productId, createdAt])
  @@map("reviews")
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now()) @map("added_at")

  // A product appears at most once in a user's wishlist. This makes "add" idempotent.
  @@unique([userId, productId])
  @@index([userId, addedAt])
  @@map("wishlist_items")
}

// Region reference data (public). Ids are the wilayah.id codes without dots, stored as text:
// province "31", city "3171", district "317107", sub-district "3171071001". A 10 digit code
// does not fit a 32 bit integer, and each code starts with its parent's code.
model Province {
  id            String          @id
  name          String          @unique
  cities        City[]
  drafts        CheckoutDraft[]
  userAddresses UserAddress[]
  shops         Shop[]

  @@map("provinces")
}

model City {
  id            String          @id
  provinceId    String          @map("province_id")
  province      Province        @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  name          String
  districts     District[]
  drafts        CheckoutDraft[]
  userAddresses UserAddress[]
  shopsInCity   Shop[]

  @@unique([provinceId, name])
  @@index([provinceId])
  @@map("cities")
}

model District {
  id            String          @id
  cityId        String          @map("city_id")
  city          City            @relation(fields: [cityId], references: [id], onDelete: Restrict)
  name          String
  subDistricts  SubDistrict[]
  drafts        CheckoutDraft[]
  userAddresses UserAddress[]
  shops         Shop[]

  @@unique([cityId, name])
  @@index([cityId])
  @@map("districts")
}

model SubDistrict {
  id            String          @id
  districtId    String          @map("district_id")
  district      District        @relation(fields: [districtId], references: [id], onDelete: Restrict)
  name          String
  drafts        CheckoutDraft[]
  userAddresses UserAddress[]
  shops         Shop[]

  @@unique([districtId, name])
  @@index([districtId])
  @@map("sub_districts")
}

// One draft per user. It holds references to cart items, never copies of price or quantity.
// Length and digit rules for the address columns are CHECK constraints in the migration SQL.
model CheckoutDraft {
  id                      Int                 @id @default(autoincrement())
  userId                  Int                 @unique @map("user_id")
  user                    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  addressLabel            String?             @map("address_label")
  addressStreet           String?             @map("address_street")
  recipientName           String?             @map("recipient_name")
  phone                   String?
  provinceId              String?             @map("province_id")
  province                Province?           @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  cityId                  String?             @map("city_id")
  city                    City?               @relation(fields: [cityId], references: [id], onDelete: SetNull)
  districtId              String?             @map("district_id")
  district                District?           @relation(fields: [districtId], references: [id], onDelete: SetNull)
  subDistrictId           String?             @map("sub_district_id")
  subDistrict             SubDistrict?        @relation(fields: [subDistrictId], references: [id], onDelete: SetNull)
  damageProtectionEnabled Boolean             @default(false) @map("damage_protection_enabled")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")
  items                   CheckoutDraftItem[]

  @@map("checkout_drafts")
}

model CheckoutDraftItem {
  id         Int           @id @default(autoincrement())
  draftId    Int           @map("draft_id")
  draft      CheckoutDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  cartItemId Int           @map("cart_item_id")
  // Removing the cart item removes its draft item.
  cartItem   CartItem      @relation(fields: [cartItemId], references: [id], onDelete: Cascade)

  @@unique([draftId, cartItemId])
  @@index([cartItemId])
  @@map("checkout_draft_items")
}

// One saved address per user. The unique userId makes "save" an upsert.
// The street length and the 5 digit zip code are CHECK constraints in the migration.
model UserAddress {
  id            Int         @id @default(autoincrement())
  userId        Int         @unique @map("user_id")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  street        String
  subDistrictId String      @map("sub_district_id")
  subDistrict   SubDistrict @relation(fields: [subDistrictId], references: [id], onDelete: Restrict)
  districtId    String      @map("district_id")
  district      District    @relation(fields: [districtId], references: [id], onDelete: Restrict)
  cityId        String      @map("city_id")
  city          City        @relation(fields: [cityId], references: [id], onDelete: Restrict)
  provinceId    String      @map("province_id")
  province      Province    @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  zipCode       String      @map("zip_code")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("user_addresses")
}

model ShippingChannel {
  id        Int                   @id @default(autoincrement())
  name      String                @unique
  sortOrder Int                   @map("sort_order")
  shops     ShopShippingChannel[]
  options   ShippingOption[]

  @@map("shipping_channels")
}

model ShopShippingChannel {
  shopId            Int             @map("shop_id")
  shop              Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shippingChannelId Int             @map("shipping_channel_id")
  shippingChannel   ShippingChannel @relation(fields: [shippingChannelId], references: [id], onDelete: Restrict)

  @@id([shopId, shippingChannelId])
  @@map("shop_shipping_channels")
}

// A delivery service of a channel, for example JNE "Regular". PROVISIONAL: the shipping task
// may change these fields. Prices are integer IDR.
model ShippingOption {
  id        Int             @id @default(autoincrement())
  channelId Int             @map("channel_id")
  channel   ShippingChannel @relation(fields: [channelId], references: [id], onDelete: Restrict)
  name      String
  price     Int
  minDays   Int             @map("min_days")
  maxDays   Int             @map("max_days")
  isActive  Boolean         @default(true) @map("is_active")

  @@unique([channelId, name])
  @@map("shipping_options")
}

enum VoucherType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

// PROVISIONAL, like ShippingOption. The meaning of `value` depends on the type:
//   PERCENT: percent off (1 to 100), capped by maxDiscount when set
//   FIXED: IDR off
//   FREE_SHIPPING: the most IDR of shipping the voucher covers
// shopId null means a platform voucher. Rules Prisma cannot express are CHECK constraints in the migration.
model Voucher {
  id          Int         @id @default(autoincrement())
  code        String      @unique
  title       String
  type        VoucherType
  value       Int
  maxDiscount Int?        @map("max_discount")
  minSpend    Int         @default(0) @map("min_spend")
  shopId      Int?        @map("shop_id")
  shop        Shop?       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  startsAt    DateTime    @map("starts_at")
  endsAt      DateTime    @map("ends_at")
  // Null means unlimited.
  usageLimit  Int?        @map("usage_limit")
  usedCount   Int         @default(0) @map("used_count")
  isActive    Boolean     @default(true) @map("is_active")

  @@index([shopId])
  @@map("vouchers")
}

// PROVISIONAL, like ShippingOption. No payment provider is connected (see the project decisions).
model PaymentMethod {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String
  description String  @default("")
  isEnabled   Boolean @default(true) @map("is_enabled")
  sortOrder   Int     @map("sort_order")

  @@map("payment_methods")
}
